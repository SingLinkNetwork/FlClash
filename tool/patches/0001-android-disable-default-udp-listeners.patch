diff --git a/listener/listener_security_test.go b/listener/listener_security_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..2e5109dd3bb7fbb5d95a8a98a7cf76e44b8b634e
--- /dev/null
+++ b/listener/listener_security_test.go
@@ -0,0 +1,35 @@
+package listener
+
+import "testing"
+
+func TestShouldDisableDefaultUDP(t *testing.T) {
+	tests := []struct {
+		name         string
+		androidBuild bool
+		want         bool
+	}{
+		{
+			name:         "desktop",
+			androidBuild: false,
+			want:         false,
+		},
+		{
+			name:         "android",
+			androidBuild: true,
+			want:         true,
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if got := shouldDisableDefaultUDP(test.androidBuild); got != test.want {
+				t.Fatalf(
+					"shouldDisableDefaultUDP(%t) = %t, want %t",
+					test.androidBuild,
+					got,
+					test.want,
+				)
+			}
+		})
+	}
+}
